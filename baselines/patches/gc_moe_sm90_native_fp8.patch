+# ---------------------------------------------------------------------------
+# Routed FP8 x FP8 (E4M3 weights, per-128x128 FP32 scales)
+# ---------------------------------------------------------------------------
+
+def _pack_fp8_routed_tile(weights, scales, pair_l1):
+    """Pack (E, N, K) E4M3 weights into 33792-byte SM90 stage records.
+
+    The 32768B payload is the exact ``_transform_shared`` layout used by the
+    native shared-expert FP8 WGMMA path: per 256-row tile, four 64-row
+    quarters, each holding four K32 groups of 128 lane vectors (16B each).
+    ``pair_l1`` interleaves 128-row gate/up blocks exactly like the FP4
+    transform.  The trailing 1024B hold one FP32 K128 scale per row, ordered
+    by quarter (64 rows each), matching the routed reader.
+    """
+    if weights.dtype != torch.float8_e4m3fn or scales.dtype != torch.float32:
+        raise ValueError('routed FP8 weights require E4M3 data and FP32 scales')
+    e, n, k = weights.shape
+    if weights.ndim != 3 or n % 256 or k % 128:
+        raise ValueError('invalid routed FP8 geometry')
+    if tuple(scales.shape) != (e, n // 128, k // 128):
+        raise ValueError('routed FP8 scales must be per-128x128 blocks')
+    if pair_l1 and (n // 2) % 128:
+        raise ValueError('L1 gate/up halves must be 128-row aligned')
+    record = torch.empty((e, n // 256, k // 128, 33792), dtype=torch.uint8,
+                         device=weights.device)
+    for expert in range(e):
+        tiled, tiled_sf = _transform_shared((weights[expert], scales[expert]),
+                                            (1, 128, 128), pair_l1)
+        # [tile, kblock, quarter, group, lane, 16B] -> 32768B stage payload.
+        record[expert, :, :, :32768] = tiled.reshape(
+            n // 256, k // 128, 32768)
+        # Keep one K128 scale per row in quarter-major order.
+        per_row = tiled_sf[..., 0].contiguous()
+        record[expert, :, :, 32768:] = per_row.view(torch.uint8).reshape(
+            n // 256, k // 128, 1024)
+    return record
+
+
+def transform_fp8_weights_for_gc_moe_sm90(l1_weights, l2_weights):
+    """Convert (E4M3, per-128x128 FP32 scales) routed weights to SM90 records."""
+    pairs = (l1_weights, l2_weights)
+    if any(not isinstance(pair, (tuple, list)) or len(pair) != 2 or
+           any(not isinstance(tensor, torch.Tensor) for tensor in pair)
+           for pair in pairs):
+        raise ValueError('SM90 FP8 transform needs two (payload, scale) pairs')
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError('transform SM90 weights outside CUDA Graph capture')
+    inputs = tuple(tensor for pair in pairs for tensor in pair)
+    if any(not tensor.is_cuda for tensor in inputs):
+        raise ValueError('SM90 FP8 transform inputs must use CUDA storage')
+    device = torch.cuda.current_device()
+    if any(tensor.device.index != device for tensor in inputs):
+        raise ValueError('SM90 FP8 transform inputs must use the current device')
+    l1, l1_sf = l1_weights
+    l2, l2_sf = l2_weights
+    if (l1.shape[0] != l2.shape[0] or l1.shape[1] != 2 * l2.shape[2]
+            or l2.shape[1] != l1.shape[2]):
+        raise ValueError('W1/W2 geometry mismatch')
+    record1 = _pack_fp8_routed_tile(l1, l1_sf, True)
+    record2 = _pack_fp8_routed_tile(l2, l2_sf, False)
+    ones1 = torch.ones((l1.shape[0],), dtype=torch.float32, device=l1.device)
+    ones2 = torch.ones((l2.shape[0],), dtype=torch.float32, device=l2.device)
+    return (record1, ones1), (record2, ones2)
